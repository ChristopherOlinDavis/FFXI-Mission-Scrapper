{
  "name": "ffxi-mission-scraper",
  "version": "1.0.0",
  "description": "Web scraper for Final Fantasy XI mission data from community wikis",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "scrape": "node src/index.js scrape",
    "scrape:all": "node src/index.js scrape --all",
    "scrape:demo": "node src/index.js scrape --set bastok-rank-demo",
    "list": "node src/index.js list",
    "check": "node src/index.js check",
    "test": "echo \"Error: no test specified\" && exit 1",
    "download:init": "node src/utils/download-manager.js init",
    "download:list": "node src/utils/download-manager.js list",
    "download:status": "node src/utils/download-manager.js status",
    "download:all": "node src/utils/download-manager.js download all",
    "download": "node src/utils/download-manager.js download",
    "download:discover": "node src/utils/download-manager.js discover",
    "download:discover:all": "node src/utils/download-manager.js discover all",
    "links:discover": "node src/utils/link-parser.js discover",
    "links:discover:all": "node src/utils/link-parser.js discover all",
    "links:test": "node src/utils/link-parser.js test",
    "urls:deduplicate": "node src/utils/url-deduplicator.js deduplicate",
    "urls:dedup": "node src/utils/url-deduplicator.js dedup",
    "urls:dry-run": "node src/utils/url-deduplicator.js dry-run",
    "urls:stats": "node src/utils/url-deduplicator.js stats",
    "html:deduplicate": "node src/utils/html-deduplicator.js deduplicate",
    "html:dedup": "node src/utils/html-deduplicator.js dedup",
    "html:dry-run": "node src/utils/html-deduplicator.js dry-run",
    "html:orphaned": "node src/utils/html-deduplicator.js orphaned",
    "html:duplicates": "node src/utils/html-deduplicator.js duplicates",
    "html:stats": "node src/utils/html-deduplicator.js stats",
    "parse:mission": "node src/utils/mission-parser.js parse",
    "parse:set": "node src/utils/mission-parser.js parse-set",
    "parse:all": "node src/utils/mission-parser.js parse-all",
    "extract-main": "node src/utils/extract-main.js",
    "extract-main:in-place": "node src/utils/extract-main.js --in-place",
    "bestiary": "node src/index.js bestiary",
    "bestiary:families": "node src/index.js bestiary --families",
    "bestiary:full": "node src/index.js bestiary --families --variants",
    "bestiary:stats": "node src/index.js bestiary-stats",
    "urls:merge-all": "node merge-all-urls.js",
    "urls:config": "node src/utils/url-config-generator.js",
    "urls:download-all": "node download-all-urls.js",
    "urls:test": "node test-new-urls.js",
    "parse:bgwiki": "node parse-all-bgwiki.js",
    "parse:local": "node parse-local-html.js",
    "parse:status": "cat parse-checkpoint.json | jq '.processed | length' && cat parse-checkpoint.json | jq '.skipped | length'",
    "extract:test": "node test-extraction-run.js",
    "extract:batch": "node batch-extractor.js",
    "extract:status": "cat extraction-checkpoint.json | jq '.processedUrls | length' && cat extraction-checkpoint.json | jq '.failed | length'",
    "crawl": "node site-crawler.js",
    "crawl:roe": "node site-crawler.js https://www.bg-wiki.com/ffxi/Category:Records_of_Eminence ./scraped_docs/roe 50",
    "crawl:missions": "node site-crawler.js https://www.bg-wiki.com/ffxi/Category:Missions ./scraped_docs/missions 100"
  },
  "keywords": [
    "ffxi",
    "scraper",
    "missions",
    "final-fantasy-xi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mendable/firecrawl-js": "^4.10.0",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.1.2",
    "commander": "^11.1.0",
    "jsdom": "^24.1.0",
    "p-limit": "^7.2.0",
    "playwright": "^1.40.1",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
