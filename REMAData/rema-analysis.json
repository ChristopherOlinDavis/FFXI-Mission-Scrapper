  "scraping_strategy": {
    "overview": "Two-phase scraping approach: list page + individual weapon pages",
    "phase_1_list_page": {
      "url": "https://ffxiclopedia.fandom.com/wiki/Ultimate_Weapons",
      "purpose": "Get list of all weapons with basic info",
      "data_to_extract": [
        "Weapon names and URLs",
        "Weapon categories (Relic/Mythic/Empyrean/Aeonic/Ergon)",
        "Weapon types (Dagger, Sword, etc.)",
        "Associated weapon skills",
        "Job restrictions",
        "Weapon skill modifiers and skillchain properties"
      ],
      "table_identification": {
        "Relic-Empyrean-Aeonic": "Table with rowspan headers for weapon types, 3 weapons per type",
        "Mythic-Ergon": "Table organized by job, 1-2 weapons per job"
      },
      "selectors": {
        "weapon_type_header": "th[bgcolor='#CEE0F2'][rowspan='3']",
        "weapon_row": "tr with 7-8 td/th cells containing weapon skill, type, linked weapon",
        "weapon_link": "a[href^='/ffxi/'][title]"
      }
    },
    "phase_2_individual_pages": {
      "url_pattern": "https://ffxiclopedia.fandom.com/wiki/{weapon_name}",
      "purpose": "Get detailed upgrade path and requirements",
      "data_to_extract": [
        "Base weapon stats (DMG, Delay, DPS, etc.)",
        "All upgrade stages (usually 5-6 stages)",
        "Stage names (e.g., 'Mandau', 'Mandau +1', 'Mandau +2', 'Mandau 90', 'Mandau 95', 'Mandau 99', 'Mandau 119', etc.)",
        "Required items/materials for each upgrade",
        "Stats at each stage",
        "Acquisition quest/method for base weapon",
        "Augment system details for 119 III versions",
        "Special effects and hidden attributes",
        "Aftermath effects"
      ],
      "expected_structure": {
        "progression_table": "Table showing stages from base -> final form",
        "materials_section": "List or table of required materials per stage",
        "stats_table": "Equipment stats at different item levels",
        "acquisition_section": "How to obtain the base weapon"
      },
      "sample_weapons_to_test": [
        "Mandau (Relic Dagger)",
        "Ragnarok (Relic Great Sword)",
        "Vajra (Mythic Dagger)",
        "Twashtar (Empyrean Dagger)",
        "Aeneas (Aeonic Dagger)",
        "Idris (Ergon Club)"
      ]
    },
    "challenges": {
      "inconsistent_formatting": "Weapon pages may have different table structures",
